---
import { locale, locales, origins, t } from '../i18n';

const pathname = Astro.url.pathname.replace(/\/$/, "");
const currentPage = pathname === "" ? "/" : pathname;

// The other language lives on the other domain, at the same path. From the
// 404 page there is nothing to match over there, so point at the home page.
const otherLocale = locales.find((code) => code !== locale)!;
const otherHref = origins[otherLocale] + (currentPage === '/404' ? '/' : Astro.url.pathname);
---

<nav class="navbar">
	<div class="container navbar-content">
		<a href="/" class="logo" aria-label={t.nav.logoLabel}>
			<span class="logo-text">NR</span>
		</a>
		<div class="navbar-right">
			<ul class="nav-links">
				<li>
					<a href="/" class={currentPage === '/' ? 'active' : ''}>{t.nav.home}</a>
				</li>
				<li>
					<a href="/about" class={currentPage === '/about' ? 'active' : ''}>{t.nav.about}</a>
				</li>
				<li>
					<a href="/projects" class={currentPage === '/projects' ? 'active' : ''}>{t.nav.projects}</a>
				</li>
				<li>
					<a href="/contact" class={currentPage === '/contact' ? 'active' : ''}>{t.nav.contact}</a>
				</li>
			</ul>
			<a
				class="lang-switch"
				href={otherHref}
				hreflang={otherLocale}
				rel="alternate"
				aria-label={t.nav.switchLanguage}
			>
				<svg class="lang-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="10"></circle>
					<path d="M2 12h20"></path>
					<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
				</svg>
				<span lang={otherLocale}>{otherLocale.toUpperCase()}</span>
			</a>
		</div>
	</div>
</nav>

<style>
	.navbar {
		background-color: var(--bg-secondary);
		border-bottom: 1px solid var(--border-color);
		position: sticky;
		top: 0;
		z-index: 100;
	}

	.navbar-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 1rem;
		padding-bottom: 1rem;
	}

	.logo {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--text-primary);
		position: relative;
	}

	.logo::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 100%;
		height: 2px;
		background: linear-gradient(90deg, var(--accent-blue), var(--accent-blue-light));
		transform: scaleX(0);
		transition: transform 0.3s ease;
	}

	.logo:hover::after {
		transform: scaleX(1);
	}

	.logo-text {
		background: linear-gradient(135deg, var(--accent-blue), var(--accent-blue-light));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.navbar-right {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 2rem;
	}

	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--border-color);
		border-radius: 999px;
		color: var(--text-secondary);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
	}

	.lang-switch:hover {
		color: var(--accent-blue);
		border-color: var(--accent-blue);
		background: rgba(59, 130, 246, 0.1);
	}

	.lang-icon {
		width: 15px;
		height: 15px;
		flex-shrink: 0;
	}

	.nav-links a {
		color: var(--text-secondary);
		font-weight: 500;
		position: relative;
	}

	.nav-links a:hover,
	.nav-links a.active {
		color: var(--accent-blue);
	}

	.nav-links a::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 0;
		height: 2px;
		background: linear-gradient(90deg, var(--accent-blue), var(--accent-blue-light));
		transition: width 0.3s ease;
	}

	.nav-links a:hover::after,
	.nav-links a.active::after {
		width: 100%;
	}

	@media (max-width: 768px) {
		.navbar-right {
			gap: 0.9rem;
		}

		.nav-links {
			gap: 0.9rem;
			font-size: 0.85rem;
		}

		.lang-switch {
			gap: 0.3rem;
			padding: 0.25rem 0.55rem;
			font-size: 0.8rem;
		}

		.lang-icon {
			display: none;
		}
	}

	@media (max-width: 400px) {
		.navbar-right {
			gap: 0.6rem;
		}

		.nav-links {
			gap: 0.6rem;
			font-size: 0.78rem;
		}
	}
</style>