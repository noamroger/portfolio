---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getI18n } from '../i18n';
import WindowBar from '../components/WindowBar.astro';

const { t, path } = getI18n(Astro.url.pathname);
---

<Layout title={t.notFound.metaTitle} noindex>
	<Navbar />
	<main id="main" class="error-page">
		<section class="error-hero">
			<div class="container">
				<div class="error-content">
					<div class="card error-term" aria-hidden="true">
						<WindowBar title="bash" />
						<pre><span class="t-prompt">$</span> cd <span data-missing-path>/page</span>
<span class="t-err">bash: cd: <span data-missing-path>/page</span>: No such file or directory</span>
<span class="t-prompt">$</span> echo $?
<span class="t-code">404</span>
<span class="t-prompt">$</span> <span class="cursor"></span></pre>
					</div>
					<script is:inline data-astro-rerun>
						document.querySelectorAll('[data-missing-path]').forEach((el) => { el.textContent = location.pathname; });
					</script>
					<h1 class="error-title">{t.notFound.title}</h1>
					<p class="error-message">{t.notFound.message}</p>
					<div class="error-actions">
						<a href={path('/')} class="btn btn-primary">{t.notFound.back}</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.error-page {
		flex: 1;
		display: flex;
		align-items: center;
		padding: 6rem 0;
	}

	.error-hero {
		width: 100%;
	}

	.error-content {
		max-width: 560px;
	}

	.error-term {
		overflow: hidden;
		margin-bottom: 2.5rem;
		transform: rotate(-0.6deg);
	}

	.error-term pre {
		padding: 1rem 1.25rem 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		line-height: 1.8;
		color: var(--text);
		white-space: pre-wrap;
		word-break: break-all;
	}

	.t-prompt {
		color: var(--accent);
		font-weight: 600;
	}

	.t-err {
		color: var(--danger);
	}

	.t-code {
		color: var(--syntax-string);
		font-weight: 600;
	}

	.error-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		margin-bottom: 1rem;
	}

	.error-message {
		font-size: 1.05rem;
		color: var(--text-secondary);
		margin-bottom: 2rem;
	}
</style>
