	}

	.vp[data-ended] .ic-replay {
		display: block;
	}

	.vp[data-volume='muted'] .ic-vol {
		display: none;
	}

	.vp[data-volume='muted'] .ic-muted {
		display: block;
	}

	.vp[data-volume='low'] .ic-vol-high {
		display: none;
	}

	.vp.is-fullscreen .ic-fs {
		display: none;
	}

	.vp.is-fullscreen .ic-fs-exit {
		display: block;
	}

	.vp-spinner {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 44px;
		height: 44px;
		margin: -22px 0 0 -22px;
