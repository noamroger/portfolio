---
import { getI18n, stackGroups } from '../i18n';

interface Props {
	/** Stacks the label above the tags, for narrow columns such as a sidebar. */
	compact?: boolean;
}

const { compact = false } = Astro.props;
const { t } = getI18n(Astro.url.pathname);
---

<dl class:list={['stack', { compact }]}>
	{stackGroups.map((group) => (
		<div class="stack-row">
			<dt>{t.stack.groups[group.key]}</dt>
			<dd class="tag-list">
				{group.items.map((item) => <span class="tag">{item}</span>)}
				{'learning' in group && group.learning.map((item) => (
					<span class="tag tag-learning">{item} · {t.stack.learning}</span>
				))}
			</dd>
		</div>
	))}
</dl>

<style>
	.stack-row {
		display: grid;
		grid-template-columns: 16rem 1fr;
		gap: 1.5rem;
		align-items: baseline;
		padding: 1rem 0;
		border-top: 1px solid var(--border);
	}

	.stack-row:last-child {
		border-bottom: 1px solid var(--border);
	}

	dt {
		font-size: 0.925rem;
		font-weight: 500;
		color: var(--text);
	}

	.compact .stack-row {
		grid-template-columns: 1fr;
		gap: 0.6rem;
		padding: 0.9rem 0;
	}

	.compact .stack-row:first-child {
		border-top: none;
		padding-top: 0;
	}

	.compact .stack-row:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.compact dt {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		color: var(--text-muted);
	}

	@media (max-width: 768px) {
		.stack-row {
			grid-template-columns: 1fr;
			gap: 0.6rem;
		}
	}
</style>
