	/* Tooltip with the shortcut, above the button. */
	.vp-btn[data-tip]::after {
		content: attr(data-tip);
		position: absolute;
		bottom: calc(100% + 8px);
		left: 50%;
		translate: -50% 0;
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: var(--vp-panel);
