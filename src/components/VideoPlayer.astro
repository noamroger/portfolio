	/* Touch screens have no hover: no volume slider, no shortcut tooltips. */
	@media (hover: none) {
		.vm-close kbd,
		.vp-range,
		.vp-hint,
		[data-vp-help-toggle],
		.vp-btn[data-tip]::after {
			display: none;
		}

		.vp-speed {
			margin-left: auto;
		}
	}
</style>
