---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { contactEmail, getI18n } from '../i18n';

const { t, locale } = getI18n(Astro.url.pathname);

// Public Turnstile site key, inlined at build time from wrangler.jsonc `vars`
// (see astro.config.mjs). Without it the widget is left out and the form works
// as before.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout title={t.contact.metaTitle} description={t.contact.metaDescription} pageType="ContactPage">
	<Navbar />
	<main id="main" class="contact">
		<header class="page-header">
			<div class="container">
				<span class="eyebrow">{t.contact.eyebrow}</span>
				<h1>{t.contact.heading}</h1>
				<p>{t.contact.subtitle}</p>
			</div>
		</header>

		<section class="section">
			<div class="container">
				<div class="contact-grid">
					<div class="contact-info">
						<h2>{t.contact.infoTitle}</h2>
						<p>{t.contact.infoText}</p>

						<div class="contact-methods">
							<div class="contact-method">
								<div class="contact-icon">
									<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
										<polyline points="22,6 12,13 2,6"></polyline>
									</svg>
								</div>
								<div>
									<h3>{t.contact.emailLabel}</h3>
									<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
								</div>
							</div>

							<div class="contact-method">
								<div class="contact-icon">
									<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
									</svg>
								</div>
								<div>
									<h3>{t.contact.githubLabel}</h3>
									<a href="https://github.com/noamroger" target="_blank" rel="me noopener noreferrer">github.com/noamroger</a>
								</div>
							</div>

							<div class="contact-method">
								<div class="contact-icon">
									<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
										<rect x="2" y="9" width="4" height="12"></rect>
										<circle cx="4" cy="4" r="2"></circle>
									</svg>
								</div>
								<div>
									<h3>{t.contact.linkedinLabel}</h3>
									<a href="https://linkedin.com/in/noamroger" target="_blank" rel="me noopener noreferrer">linkedin.com/in/noamroger</a>
								</div>
							</div>
						</div>
					</div>

					<div class="card contact-form-wrapper">
						<h2 class="form-title">{t.contact.formTitle}</h2>
						<form
							class="contact-form"
							id="contact-form"
							method="post"
							action="https://form.noam.ovh/portfolio"
							name="contact"
							data-sending={t.contact.form.sending}
							data-success={t.contact.form.success}
							data-error={t.contact.form.error}
							data-failure={t.contact.form.failure}
						>

							<div class="form-row">
							<div class="form-group">
								<label for="name">{t.contact.form.name}</label>
								<input type="text" id="name" name="name" required placeholder={t.contact.form.namePlaceholder} />
							</div>

							<div class="form-group">
								<label for="email">{t.contact.form.email}</label>
								<input type="email" id="email" name="email" required placeholder={t.contact.form.emailPlaceholder} />
							</div>

							</div>

							<div class="form-group">
								<label for="subject">{t.contact.form.subject}</label>
								<input type="text" id="subject" name="subject" required placeholder={t.contact.form.subjectPlaceholder} />
							</div>

							<div class="form-group">
								<label for="message">{t.contact.form.message}</label>
								<textarea id="message" name="message" rows="5" required placeholder={t.contact.form.messagePlaceholder}></textarea>
							</div>

							{turnstileSiteKey && (
								<div
									class="turnstile"
									id="contact-turnstile"
									data-sitekey={turnstileSiteKey}
									data-language={locale}
								></div>
							)}

							<button type="submit" class="btn btn-primary">{t.contact.form.submit}</button>
							<p class="form-status" id="form-status" role="status" aria-live="polite"></p>
						</form>
						{/*
							Inline and right after the form on purpose: it runs as soon as the
							form exists, and data-astro-rerun runs it again on every client-side
							navigation, so the submit handler never depends on a module or event
							arriving in time. Without JavaScript, the form still POSTs to the
							backend.
						*/}
						<script is:inline data-astro-rerun>
							(() => {
								const form = document.getElementById('contact-form');
								const status = document.getElementById('form-status');
								const button = form.querySelector('button[type="submit"]');

								const showStatus = (message, state) => {
									status.textContent = message;
									status.dataset.state = state;
								};

								// Turnstile, rendered explicitly: its auto-render only scans the
								// page once, which misses forms reached through the client router.
								// The widget adds a hidden cf-turnstile-response input to the form,
								// so the token travels in the JSON body with the other fields.
								const container = document.getElementById('contact-turnstile');
								let widgetId;

								const renderWidget = () => {
									if (!container?.isConnected || !window.turnstile) return;
									if (widgetId !== undefined) window.turnstile.remove(widgetId);
									widgetId = window.turnstile.render(container, {
										sitekey: container.dataset.sitekey,
										language: container.dataset.language,
										theme: document.documentElement.dataset.theme === 'light' ? 'light' : 'dark',
										// The flexible widget needs 300px; narrow phones get the compact one.
										size: container.clientWidth < 300 ? 'compact' : 'flexible',
									});
								};

								// A token is single use: get a fresh one after each attempt.
								const resetWidget = () => {
									if (widgetId !== undefined) window.turnstile?.reset(widgetId);
								};

								if (container) {
									if (window.turnstile) {
										renderWidget();
									} else {
										window.onTurnstileLoad = () => {
											window.dispatchEvent(new Event('turnstile-ready'));
										};
										if (!document.getElementById('turnstile-api')) {
											const api = document.createElement('script');
											api.id = 'turnstile-api';
											api.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad';
											api.async = true;
											document.head.appendChild(api);
										}
										window.addEventListener('turnstile-ready', renderWidget, { once: true });
									}

									// Follow the navbar theme toggle, and stop when leaving the page.
									const themeObserver = new MutationObserver(renderWidget);
									themeObserver.observe(document.documentElement, { attributeFilter: ['data-theme'] });
									document.addEventListener('astro:before-swap', () => {
										themeObserver.disconnect();
										if (widgetId !== undefined) window.turnstile?.remove(widgetId);
									}, { once: true });
								}

								form.addEventListener('submit', async (event) => {
									event.preventDefault();

									const originalText = button.textContent;
									status.textContent = '';
									delete status.dataset.state;
									button.textContent = form.dataset.sending;
									button.disabled = true;

									try {
										const response = await fetch(form.action, {
											method: 'POST',
											headers: { 'Content-Type': 'application/json' },
											body: JSON.stringify(Object.fromEntries(new FormData(form))),
										});
										const data = await response.json();

										if (response.ok) {
											showStatus(form.dataset.success, 'success');
											form.reset();
										} else {
											showStatus(form.dataset.error + data.message, 'error');
										}
									} catch (error) {
										console.error('Form submission error:', error);
										showStatus(form.dataset.failure, 'error');
									} finally {
										resetWidget();
										button.textContent = originalText;
										button.disabled = false;
									}
								});
							})();
						</script>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.contact {
		flex: 1;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: 4rem;
		align-items: start;
	}

	.contact-info h2 {
		font-size: 1.25rem;
		margin-bottom: 0.75rem;
	}

	.contact-info > p {
		color: var(--text-secondary);
		margin-bottom: 2rem;
		max-width: 46ch;
	}

	.contact-methods {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--border);
	}

	.contact-method {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--border);
	}

	.contact-icon {
		width: 38px;
		height: 38px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-secondary);
		flex-shrink: 0;
	}

	.contact-method h3 {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0;
		color: var(--text-muted);
		margin-bottom: 0.1rem;
	}

	.contact-method a {
		color: var(--text);
		font-size: 0.95rem;
		font-weight: 500;
	}

	.contact-method a:hover {
		color: var(--accent);
	}

	.contact-form-wrapper {
		padding: 2rem;
	}

	.form-title {
		font-size: 1.1rem;
		margin-bottom: 1.5rem;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 1rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.form-group label {
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--text-secondary);
	}

	.form-group input,
	.form-group textarea {
		background: var(--bg);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		padding: 0.7rem 0.85rem;
		color: var(--text);
		font: inherit;
		font-size: 0.95rem;
		width: 100%;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.form-group textarea {
		resize: vertical;
		min-height: 140px;
	}

	.form-group input:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px var(--accent-soft);
	}

	.form-group input::placeholder,
	.form-group textarea::placeholder {
		color: var(--text-muted);
	}

	.contact-form .btn {
		align-self: flex-start;
	}

	/* Reserve the widget's height so the button doesn't jump when it loads. */
	.turnstile {
		min-height: 65px;
	}

	.form-status {
		margin: 0;
		font-size: 0.925rem;
		font-weight: 500;
	}

	.form-status:empty {
		display: none;
	}

	.form-status[data-state='success'] {
		color: var(--success);
	}

	.form-status[data-state='error'] {
		color: var(--danger);
	}

	@media (max-width: 960px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
	}

	@media (max-width: 768px) {
		.contact-method a {
			display: inline-flex;
			align-items: center;
			min-height: 44px;
		}

		.form-row {
			grid-template-columns: 1fr;
		}

		.contact-form-wrapper {
			padding: 1.5rem;
		}

		.contact-form .btn {
			align-self: stretch;
		}
	}
</style>
