---
import { ClientRouter } from 'astro:transitions';
import { contactEmail, locale, locales, origins, socialProfiles, t, techStack } from '../i18n';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
	/** schema.org type of this page, e.g. AboutPage or ContactPage. */
	pageType?: string;
	/** Extra schema.org nodes appended to the page graph. */
	schema?: Record<string, unknown>[];
}

const {
	title,
	description = t.meta.description,
	noindex = false,
	pageType = 'WebPage',
	schema = [],
} = Astro.props;

const path = Astro.url.pathname;
const origin = origins[locale];
const canonical = origin + path;
const fullTitle = title;
const ogImage = `${origin}/og-image.png`;

// One @graph per page rather than scattered snippets: the nodes reference each
// other by @id, so a crawler reading any page gets the whole picture.
const personId = `${origin}/#person`;
const businessId = `${origin}/#business`;
const siteId = `${origin}/#website`;

const address = {
	'@type': 'PostalAddress',
	addressLocality: 'Le Mans',
	addressCountry: 'FR',
};

// Breadcrumbs: the site is flat, so it is always Home > current page.
const crumbLabels: Record<string, string> = {
	'/about': t.nav.about,
	'/projects': t.nav.projects,
	'/contact': t.nav.contact,
};
const crumbKey = path !== '/' && path.endsWith('/') ? path.slice(0, -1) : path;
const crumbLabel = crumbLabels[crumbKey];

const breadcrumb = crumbLabel
	? {
			'@type': 'BreadcrumbList',
			'@id': `${canonical}#breadcrumb`,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: t.nav.home, item: `${origin}/` },
				{ '@type': 'ListItem', position: 2, name: crumbLabel, item: canonical },
			],
		}
	: null;

const graph = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': personId,
			name: 'Noam Roger',
			jobTitle: t.meta.jobTitle,
			description: t.meta.description,
			url: `${origin}/`,
			image: ogImage,
			email: `mailto:${contactEmail}`,
			address,
			knowsAbout: techStack,
			sameAs: socialProfiles,
		},
		{
			'@type': 'ProfessionalService',
			'@id': businessId,
			name: 'Noam Roger',
			description: t.meta.description,
			url: `${origin}/`,
			image: ogImage,
			email: `mailto:${contactEmail}`,
			address,
			areaServed: { '@type': 'Country', name: 'France' },
			founder: { '@id': personId },
			knowsLanguage: ['fr', 'en'],
			sameAs: socialProfiles,
		},
		{
			'@type': 'WebSite',
			'@id': siteId,
			name: 'Noam Roger',
			url: `${origin}/`,
			inLanguage: t.htmlLang,
			publisher: { '@id': personId },
		},
		{
			'@type': pageType,
			'@id': canonical,
			url: canonical,
			name: title,
			description,
			inLanguage: t.htmlLang,
			isPartOf: { '@id': siteId },
			about: { '@id': personId },
			primaryImageOfPage: ogImage,
			...(breadcrumb ? { breadcrumb: { '@id': breadcrumb['@id'] } } : {}),
		},
		...(breadcrumb ? [breadcrumb] : []),
		...schema,
	],
};
---

<!doctype html>
<html lang={t.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0a0e17" />
		<meta name="color-scheme" content="dark" />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Noam Roger" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Noam Roger" />
		<meta property="og:locale" content={t.meta.ogLocale} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale:alternate" content={t.meta.ogLocaleAlternate} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="256" />
		<meta property="og:image:height" content="256" />
		<meta property="og:image:alt" content={t.meta.ogImageAlt} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

		{noindex ? (
			<meta name="robots" content="noindex, follow" />
		) : (
			<Fragment>
				{/* Without max-image-preview, Google caps previews at a thumbnail. */}
				<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
				<link rel="canonical" href={canonical} />
				<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
				{locales.map((code) => (
					<link rel="alternate" hreflang={code} href={origins[code] + path} />
				))}
				<link rel="alternate" hreflang="x-default" href={origins.en + path} />
			</Fragment>
		)}

		{!noindex && (
			<script type="application/ld+json" set:html={JSON.stringify(graph)} />
		)}

		<ClientRouter />
	</head>
	<body>
		<a href="#main" class="skip-link">{t.a11y.skipToContent}</a>
		<div class="particles-container" transition:persist>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
			<div class="particle"></div>
		</div>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg-primary: #0a0e17;
		--bg-secondary: #111827;
		--bg-tertiary: #1f2937;
		--text-primary: #f9fafb;
		--text-secondary: #9ca3af;
		--text-muted: #6b7280;
		--accent-blue: #3b82f6;
		--accent-blue-light: #60a5fa;
		--accent-blue-dark: #2563eb;
		--border-color: #374151;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		/* Stops iOS inflating body text when the phone is turned sideways. */
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
	}

	a,
	button {
		/* The default tap flash is an opaque light grey on this dark theme. */
		-webkit-tap-highlight-color: rgba(59, 130, 246, 0.25);
	}

	body {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		background-color: var(--bg-primary);
		color: var(--text-primary);
		line-height: 1.6;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	a {
		color: var(--accent-blue);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	a:hover {
		color: var(--accent-blue-light);
	}

	:focus-visible {
		outline: 2px solid var(--accent-blue-light);
		outline-offset: 3px;
		border-radius: 2px;
	}

	.skip-link {
		position: absolute;
		left: 1rem;
		top: -100%;
		z-index: 200;
		padding: 0.75rem 1.25rem;
		border-radius: 0 0 8px 8px;
		background: var(--bg-tertiary);
		border: 1px solid var(--accent-blue);
		color: var(--text-primary);
		font-weight: 600;
	}

	.skip-link:focus {
		top: 0;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	@media (max-width: 768px) {
		.container {
			padding: 0 1rem;
		}
	}

	.particles-container {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 0;
		overflow: hidden;
	}

	.particle {
		position: absolute;
		width: 4px;
		height: 4px;
		background: var(--accent-blue);
		border-radius: 50%;
		opacity: 0.3;
		animation: float 20s infinite ease-in-out;
	}

	.particle:nth-child(1) { left: 10%; top: 20%; animation-delay: 0s; animation-duration: 25s; }
	.particle:nth-child(2) { left: 20%; top: 80%; animation-delay: 2s; animation-duration: 20s; }
	.particle:nth-child(3) { left: 30%; top: 40%; animation-delay: 4s; animation-duration: 22s; }
	.particle:nth-child(4) { left: 40%; top: 60%; animation-delay: 1s; animation-duration: 18s; }
	.particle:nth-child(5) { left: 50%; top: 30%; animation-delay: 3s; animation-duration: 24s; }
	.particle:nth-child(6) { left: 60%; top: 70%; animation-delay: 5s; animation-duration: 21s; }
	.particle:nth-child(7) { left: 70%; top: 50%; animation-delay: 2.5s; animation-duration: 19s; }
	.particle:nth-child(8) { left: 80%; top: 90%; animation-delay: 0.5s; animation-duration: 23s; }
	.particle:nth-child(9) { left: 90%; top: 10%; animation-delay: 4.5s; animation-duration: 26s; }
	.particle:nth-child(10) { left: 15%; top: 55%; animation-delay: 1.5s; animation-duration: 20s; }
	.particle:nth-child(11) { left: 25%; top: 25%; animation-delay: 3.5s; animation-duration: 22s; }
	.particle:nth-child(12) { left: 35%; top: 75%; animation-delay: 0.8s; animation-duration: 24s; }
	.particle:nth-child(13) { left: 45%; top: 15%; animation-delay: 2.8s; animation-duration: 19s; }
	.particle:nth-child(14) { left: 55%; top: 85%; animation-delay: 4.2s; animation-duration: 21s; }
	.particle:nth-child(15) { left: 65%; top: 35%; animation-delay: 1.2s; animation-duration: 23s; }
	.particle:nth-child(16) { left: 75%; top: 65%; animation-delay: 3.2s; animation-duration: 25s; }
	.particle:nth-child(17) { left: 85%; top: 45%; animation-delay: 0.2s; animation-duration: 20s; }
	.particle:nth-child(18) { left: 5%; top: 95%; animation-delay: 4.8s; animation-duration: 22s; }
	.particle:nth-child(19) { left: 95%; top: 5%; animation-delay: 2.2s; animation-duration: 18s; }
	.particle:nth-child(20) { left: 50%; top: 50%; animation-delay: 1.8s; animation-duration: 24s; }

	@media (max-width: 768px) {
		.particle:nth-child(2n) {
			display: none;
		}

		.particle {
			width: 3px;
			height: 3px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}

		.particles-container {
			display: none;
		}
	}

	@keyframes float {
		0%, 100% {
			transform: translate(0, 0) scale(1);
			opacity: 0.3;
		}
		25% {
			transform: translate(100px, -100px) scale(1.2);
			opacity: 0.5;
		}
		50% {
			transform: translate(-50px, -200px) scale(0.8);
			opacity: 0.2;
		}
		75% {
			transform: translate(-100px, 50px) scale(1.1);
			opacity: 0.4;
		}
	}
</style>
</html>
