---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StackList from '../components/StackList.astro';
import { getI18n } from '../i18n';

const { t } = getI18n(Astro.url.pathname);

const info = [
	[t.about.infoName, 'Noam Roger'],
	[t.about.infoLocation, t.about.infoLocationValue],
	[t.about.infoEducation, t.about.infoEducationValue],
	[t.about.infoAvailability, t.about.infoAvailabilityValue],
	[t.about.infoLanguages, t.about.infoLanguagesValue],
];
---

<Layout title={t.about.metaTitle} description={t.about.metaDescription} pageType="AboutPage">
	<Navbar />
	<main id="main" class="about">
		<header class="page-header">
			<div class="container">
				<span class="eyebrow">{t.about.eyebrow}</span>
				<h1>{t.about.heading}</h1>
				<p>{t.about.subtitle}</p>
			</div>
		</header>

		<section class="section">
			<div class="container about-grid">
				<div class="about-main">
					<h2>{t.about.journeyTitle}</h2>
					<div class="prose">
						{t.about.journey.map((paragraph) => <p>{paragraph}</p>)}
					</div>

					<h2>{t.about.timelineTitle}</h2>
					<ol class="timeline">
						{t.about.timeline.map((item) => (
							<li>
								<span class="timeline-date">{item.date}</span>
								<div>
									<h3>{item.title}</h3>
									<p>{item.text}</p>
								</div>
							</li>
						))}
					</ol>

					<h2>{t.about.approachTitle}</h2>
					<ul class="approach">
						{t.about.approach.map((item) => <li>{item}</li>)}
					</ul>
				</div>

				<aside class="about-side">
					<div class="card side-card">
						<h2 class="side-title">{t.about.infoTitle}</h2>
						<dl class="info-list">
							{info.map(([label, value]) => (
								<div class="info-row">
									<dt>{label}</dt>
									<dd>{value}</dd>
								</div>
							))}
						</dl>
					</div>
					<div class="card side-card">
						<h2 class="side-title">{t.about.techTitle}</h2>
						<StackList compact />
					</div>
				</aside>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.about {
		flex: 1;
	}

	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 340px;
		gap: 4rem;
		align-items: start;
	}

	.about-main h2 {
		font-size: 1.25rem;
		margin-bottom: 1.25rem;
	}

	.about-main h2:not(:first-child) {
		margin-top: 3.5rem;
	}

	.prose p {
		color: var(--text-secondary);
		font-size: 1.025rem;
		line-height: 1.75;
		max-width: 68ch;
	}

	.prose p + p {
		margin-top: 1rem;
	}

	.timeline {
		list-style: none;
		border-left: 1px solid var(--border-strong);
		margin-left: 0.25rem;
	}

	.timeline li {
		position: relative;
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 1rem;
		padding: 0 0 1.75rem 1.5rem;
	}

	.timeline li:last-child {
		padding-bottom: 0;
	}

	.timeline li::before {
		content: '';
		position: absolute;
		left: -5px;
		top: 0.45rem;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--text-muted);
	}

	.timeline li:first-child::before {
		border-color: var(--accent);
		background: var(--accent);
	}

	.timeline-date {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-muted);
		padding-top: 0.15rem;
	}

	.timeline h3 {
		font-size: 1rem;
		margin-bottom: 0.2rem;
	}

	.timeline p {
		font-size: 0.925rem;
		color: var(--text-secondary);
	}

	.approach {
		list-style: none;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.approach li {
		padding: 1rem 1.15rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		color: var(--text-secondary);
		font-size: 0.95rem;
	}

	.about-side {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		position: sticky;
		top: 88px;
	}

	.side-card {
		padding: 1.5rem;
	}

	.side-title {
		font-size: 0.95rem;
		margin-bottom: 1rem;
	}

	.info-row {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.6rem 0;
		font-size: 0.9rem;
	}

	.info-row + .info-row {
		border-top: 1px dashed var(--border);
	}

	.info-row dt {
		color: var(--text-muted);
	}

	.info-row dd {
		text-align: right;
		font-weight: 500;
	}

	@media (max-width: 960px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.about-side {
			position: static;
		}
	}

	@media (max-width: 768px) {
		.approach {
			grid-template-columns: 1fr;
		}

		.timeline li {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
