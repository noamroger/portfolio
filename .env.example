# Langue du site, figée au build.
#   en -> noamroger.dev (valeur par défaut si la variable est absente)
#   fr -> noamroger.fr
# Sur Netlify, cette variable se définit dans les réglages du site
# (Site configuration > Environment variables), et non dans netlify.toml.
SITE_LOCALE=fr

# Statistiques de visite (Umami Cloud). Laisser vide en local : sans ID, aucun
# script n'est injecté et le bouton d'opt-out du pied de page n'apparaît pas.
# Sur Netlify, une valeur différente par site (un site Umami par domaine).
PUBLIC_UMAMI_WEBSITE_ID=

# Optionnels, uniquement pour une instance Umami auto-hébergée :
# PUBLIC_UMAMI_SRC=https://stats.example.com/script.js
# PUBLIC_UMAMI_HOST_URL=https://stats.example.com
