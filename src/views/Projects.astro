---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { getI18n, siteOrigin } from '../i18n';
import { projects as projectLinks, type ProjectKey } from '../data/projects';

import californyan from '../assets/projects/californyan.webp';
import codenames from '../assets/projects/codenames.webp';
import gaulia from '../assets/projects/gaulia.webp';
import romaybot from '../assets/projects/romaybot.webp';
import webserver from '../assets/projects/webserver.webp';

const { t } = getI18n(Astro.url.pathname);

// Cards are 1 column below ~820px, 2 columns above, capped at ~552px each.
const cardSizes = '(min-width: 1200px) 552px, (min-width: 820px) 50vw, 100vw';
const cardWidths = [380, 560, 760, 1024];

const images: Record<ProjectKey, ImageMetadata> = {
	californyan,
	webserver,
	romaybot,
	codenames,
	webserverTs: webserver,
	gaulia,
};

const projects = projectLinks.map((project) => ({
	...t.projects.items[project.key],
	...project,
	image: images[project.key],
}));
const origin = siteOrigin;

// Each card is a real public repository, so it maps onto SoftwareSourceCode.
const projectList = [
	{
		'@type': 'ItemList',
		'@id': `${origin}${Astro.url.pathname}#list`,
		numberOfItems: projects.length,
		itemListElement: projects.map((project, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			item: {
				'@type': 'SoftwareSourceCode',
				name: project.title,
				description: project.description,
				programmingLanguage: project.tech,
				codeRepository: project.github,
				author: { '@id': `${origin}/#person` },
			},
		})),
	},
];
---

<Layout title={t.projects.metaTitle} description={t.projects.metaDescription} pageType="CollectionPage" schema={projectList}>
	<Navbar />
	<main id="main" class="projects">
		<header class="page-header">
			<div class="container">
				<span class="eyebrow">{t.projects.eyebrow}</span>
				<h1>{t.projects.heading}</h1>
				<p>{t.projects.subtitle}</p>
			</div>
		</header>

		<section class="section">
			<div class="container">
				<div class="projects-grid">
					{projects.map((project, i) => (
						<article class="card project-card">
							<div class="project-image">
								<Image
									src={project.image}
									alt={project.imageAlt}
									widths={cardWidths}
									sizes={cardSizes}
									loading={i < 2 ? 'eager' : 'lazy'}
									decoding={i < 2 ? 'sync' : 'async'}
								/>
							</div>
							<div class="project-content">
								<span class="project-context">{project.context}</span>
								<h2 class="project-title">{project.title}</h2>
								<p class="project-description">{project.description}</p>
								<div class="tag-list project-tech">
									{project.tech.map((tech) => (
										<span class="tag">{tech}</span>
									))}
								</div>
								<div class="project-links">
									<a href={project.github} class="project-link" target="_blank" rel="noopener noreferrer">
										<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
											<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
										</svg>
										{t.projects.codeLink}
									</a>
									{project.demo && (
										<a href={project.demo} class="project-link" target="_blank" rel="noopener noreferrer">
											<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
												<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
												<polyline points="15 3 21 3 21 9"></polyline>
												<line x1="10" y1="14" x2="21" y2="3"></line>
											</svg>
											{t.projects.demoLink}
										</a>
									)}
								</div>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.projects {
		flex: 1;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.project-card {
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
	}

	.project-card:hover {
		border-color: var(--accent);
		transform: translate(-2px, -2px);
		box-shadow: 4px 4px 0 color-mix(in srgb, var(--accent) 45%, transparent);
	}

	.project-image img {
		transition: transform 0.4s ease;
	}

	.project-card:hover .project-image img {
		transform: scale(1.03);
	}

	.project-image {
		aspect-ratio: 16 / 8;
		overflow: hidden;
		border-bottom: 1px solid var(--border);
		background: var(--bg-subtle);
	}

	.project-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.project-content {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.project-context {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.project-title {
		font-size: 1.2rem;
		margin-bottom: 0.6rem;
	}

	.project-description {
		color: var(--text-secondary);
		font-size: 0.95rem;
		margin-bottom: 1.25rem;
		flex: 1;
	}

	.project-tech {
		margin-bottom: 1.25rem;
	}

	.project-links {
		display: flex;
		gap: 0.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
	}

	.project-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		color: var(--text-secondary);
		font-size: 0.85rem;
		font-weight: 500;
		transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
	}

	.project-link:hover {
		color: var(--text);
		border-color: var(--border-strong);
		background: var(--bg-subtle);
	}

	@media (max-width: 820px) {
		.projects-grid {
			grid-template-columns: 1fr;
		}

		.project-link {
			min-height: 44px;
			padding: 0.5rem 1rem;
		}
	}
</style>
