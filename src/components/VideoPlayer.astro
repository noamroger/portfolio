---
/**
 * A video in a modal window, with its own controls and YouTube-style keyboard
 * shortcuts. The page opens it from any element carrying
 * `data-video-open="<id>"`; that element should be a link to the file itself,
 * so the video still opens (in the browser's own player) without JavaScript.
 */
import { getImage } from 'astro:assets';
import { getI18n } from '../i18n';

interface Props {
	id: string;
	src: string;
	poster: ImageMetadata;
	/** Shown in the window bar, like a file path. */
	label: string;
	/** Name of the video for screen readers. */
	title: string;
}

const { id, src, poster, label, title } = Astro.props;
const { t } = getI18n(Astro.url.pathname);
const p = t.player;
const posterImage = await getImage({ src: poster, width: 1280, format: 'webp' });
---

<dialog class="vm" id={id} aria-label={p.dialogLabel.replace('{title}', title)} data-video-modal>
	<div class="vm-window">
		<div class="window-bar vm-bar">
			<i></i><i></i><i></i>
			<span aria-hidden="true">{label}</span>
			<button type="button" class="vm-close" data-vp-close aria-label={p.close}>
				<kbd aria-hidden="true">esc</kbd>
				<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
			</button>
		</div>

		<div class="vp" data-vp data-paused tabindex="-1">
			<video playsinline preload="none" data-src={src} data-poster={posterImage.src}></video>

			<button type="button" class="vp-big" data-vp-toggle aria-label={p.play} tabindex="-1">
				<svg class="ic-play" aria-hidden="true" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
				<svg class="ic-replay" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
			</button>
			<div class="vp-spinner" aria-hidden="true"></div>
			<div class="vp-osd" aria-hidden="true"></div>

			<div class="vp-error" hidden>
				<p>{p.error}</p>
				<a href={src} data-astro-reload data-astro-prefetch="false">{p.openFile}</a>
			</div>

			<div class="vp-help" data-vp-help hidden>
				<div class="vp-help-box">
					<p class="vp-help-title"><span>$</span> help --shortcuts</p>
					<dl>
						{p.keys.map(([keys, action]) => (
							<div>
								<dt><kbd>{keys}</kbd></dt>
								<dd>{action}</dd>
							</div>
						))}
					</dl>
				</div>
			</div>

			<div class="vp-controls">
				<div class="vp-progress" data-vp-progress role="slider" tabindex="0" aria-label={p.seek} aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-valuetext="0:00">
					<div class="vp-track">
						<div class="vp-buffered"></div>
						<div class="vp-played"></div>
						<div class="vp-hover"></div>
					</div>
					<div class="vp-thumb"></div>
					<div class="vp-tip" aria-hidden="true">0:00</div>
				</div>

				<div class="vp-row">
					<button type="button" class="vp-btn" data-vp-toggle data-tip={`${p.play} (k)`} aria-label={p.play}>
						<svg class="ic-play" aria-hidden="true" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
						<svg class="ic-pause" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><rect x="6.5" y="5" width="4" height="14" rx="1" /><rect x="13.5" y="5" width="4" height="14" rx="1" /></svg>
						<svg class="ic-replay" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
					</button>
					<button type="button" class="vp-btn vp-skip" data-vp-skip="-10" data-tip={`${p.back} (j)`} aria-label={p.back}>
						<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /><text x="12" y="15.5" text-anchor="middle" font-size="7.5" font-weight="700" fill="currentColor" stroke="none">10</text></svg>
					</button>
					<button type="button" class="vp-btn vp-skip" data-vp-skip="10" data-tip={`${p.forward} (l)`} aria-label={p.forward}>
						<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" /><text x="12" y="15.5" text-anchor="middle" font-size="7.5" font-weight="700" fill="currentColor" stroke="none">10</text></svg>
					</button>

					<div class="vp-volume">
						<button type="button" class="vp-btn" data-vp-mute data-tip={`${p.mute} (m)`} aria-label={p.mute}>
							<svg class="ic-vol" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" /><path class="ic-vol-low" d="M15.5 9.5a3.5 3.5 0 0 1 0 5" /><path class="ic-vol-high" d="M18 7a7 7 0 0 1 0 10" /></svg>
							<svg class="ic-muted" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" /><path d="M16 9.5l5 5M21 9.5l-5 5" /></svg>
						</button>
						<input type="range" class="vp-range" data-vp-volume min="0" max="1" step="0.05" value="1" aria-label={p.volume} />
					</div>

					<span class="vp-time"><span data-vp-current>0:00</span><span class="vp-sep"> / </span><span data-vp-duration>0:00</span></span>

					<span class="vp-hint" aria-hidden="true">{p.hint}</span>

					<button type="button" class="vp-btn vp-speed" data-vp-speed data-tip={`${p.speed} (< >)`} aria-label={p.speed}>1x</button>
					<button type="button" class="vp-btn" data-vp-help-toggle data-tip={`${p.shortcuts} (?)`} aria-label={p.shortcuts} aria-expanded="false">
						<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="6" width="19" height="12" rx="2" /><path d="M6.5 10h.01M10 10h.01M14 10h.01M17.5 10h.01M8 14h8" /></svg>
					</button>
					<button type="button" class="vp-btn" data-vp-pip data-tip={`${p.pip} (i)`} aria-label={p.pip} hidden>
						<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="2" /><rect x="12" y="11.5" width="7" height="5.5" rx="1" fill="currentColor" stroke="none" /></svg>
					</button>
					<button type="button" class="vp-btn" data-vp-fullscreen data-tip={`${p.fullscreen} (f)`} aria-label={p.fullscreen}>
						<svg class="ic-fs" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" /></svg>
						<svg class="ic-fs-exit" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4v5H4M20 9h-5V4M15 20v-5h5M4 15h5v5" /></svg>
					</button>
				</div>
			</div>
		</div>
	</div>
</dialog>

<script is:inline type="application/json" data-vp-strings set:html={JSON.stringify({
	play: p.play,
	pause: p.pause,
	replay: p.replay,
	mute: p.mute,
	unmute: p.unmute,
	fullscreen: p.fullscreen,
	exitFullscreen: p.exitFullscreen,
})} />

<script>
	type Strings = Record<'play' | 'pause' | 'replay' | 'mute' | 'unmute' | 'fullscreen' | 'exitFullscreen', string>;

	const SPEEDS = [0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2];
	const VOLUME_KEY = 'player-volume';
	const IDLE_MS = 2500;

	const format = (seconds: number) => {
		if (!Number.isFinite(seconds)) seconds = 0;
		const s = Math.floor(seconds % 60).toString().padStart(2, '0');
		const m = Math.floor(seconds / 60) % 60;
		const h = Math.floor(seconds / 3600);
		return h ? `${h}:${m.toString().padStart(2, '0')}:${s}` : `${m}:${s}`;
	};

	const readVolume = () => {
		try {
			const saved = JSON.parse(localStorage.getItem(VOLUME_KEY) ?? 'null');
			if (saved && typeof saved.volume === 'number') return saved as { volume: number; muted: boolean };
		} catch {
			// Blocked storage or garbage: use the defaults.
		}
		return { volume: 1, muted: false };
	};

	const saveVolume = (video: HTMLVideoElement) => {
		try {
			localStorage.setItem(VOLUME_KEY, JSON.stringify({ volume: video.volume, muted: video.muted }));
		} catch {
			// Not worth bothering anyone about.
		}
	};

	function setup(dialog: HTMLDialogElement, strings: Strings) {
		const root = dialog.querySelector<HTMLElement>('[data-vp]')!;
		const video = root.querySelector('video')!;
		const progress = root.querySelector<HTMLElement>('[data-vp-progress]')!;
		const played = root.querySelector<HTMLElement>('.vp-played')!;
		const buffered = root.querySelector<HTMLElement>('.vp-buffered')!;
		const hover = root.querySelector<HTMLElement>('.vp-hover')!;
		const thumb = root.querySelector<HTMLElement>('.vp-thumb')!;
		const tip = root.querySelector<HTMLElement>('.vp-tip')!;
		const current = root.querySelector<HTMLElement>('[data-vp-current]')!;
		const duration = root.querySelector<HTMLElement>('[data-vp-duration]')!;
		const volume = root.querySelector<HTMLInputElement>('[data-vp-volume]')!;
		const muteBtn = root.querySelector<HTMLButtonElement>('[data-vp-mute]')!;
		const speedBtn = root.querySelector<HTMLButtonElement>('[data-vp-speed]')!;
		const helpBtn = root.querySelector<HTMLButtonElement>('[data-vp-help-toggle]')!;
		const help = root.querySelector<HTMLElement>('[data-vp-help]')!;
		const pipBtn = root.querySelector<HTMLButtonElement>('[data-vp-pip]')!;
		const fsBtn = root.querySelector<HTMLButtonElement>('[data-vp-fullscreen]')!;
		const toggles = root.querySelectorAll<HTMLButtonElement>('[data-vp-toggle]');
		const osd = root.querySelector<HTMLElement>('.vp-osd')!;
		const error = root.querySelector<HTMLElement>('.vp-error')!;

		let idleTimer = 0;
		let osdTimer = 0;
		let scrubbing = false;
		let resumeAfterScrub = false;

		const saved = readVolume();
		video.volume = saved.volume;
		video.muted = saved.muted;

		if (document.pictureInPictureEnabled && !video.disablePictureInPicture) pipBtn.hidden = false;
		// iOS Safari has no element fullscreen, only the native video one.
		const canFullscreen = document.fullscreenEnabled || 'webkitEnterFullscreen' in video;
		if (!canFullscreen) fsBtn.hidden = true;

		const load = () => {
			if (video.src) return;
			video.poster = video.dataset.poster ?? '';
			video.preload = 'auto';
			video.src = video.dataset.src ?? '';
		};

		// Small text in the middle of the picture, like "+10 s" or "volume 80 %".
		const flash = (text: string) => {
			osd.textContent = text;
			osd.classList.remove('is-on');
			void osd.offsetWidth;
			osd.classList.add('is-on');
			clearTimeout(osdTimer);
			osdTimer = window.setTimeout(() => osd.classList.remove('is-on'), 650);
		};

		const showControls = () => {
			root.classList.remove('is-idle');
			clearTimeout(idleTimer);
			if (!video.paused && help.hidden) {
				idleTimer = window.setTimeout(() => {
					if (!video.paused && !root.matches(':has(.vp-controls:hover, .vp-controls :focus-visible)')) root.classList.add('is-idle');
				}, IDLE_MS);
			}
		};

		const togglePlay = () => {
			load();
			if (video.paused || video.ended) video.play().catch(() => {});
			else video.pause();
		};

		const seek = (time: number) => {
			if (!Number.isFinite(video.duration)) return;
			video.currentTime = Math.min(Math.max(time, 0), video.duration);
			render();
		};

		const skip = (seconds: number) => {
			seek(video.currentTime + seconds);
			flash(`${seconds > 0 ? '+' : '−'}${Math.abs(seconds)} s`);
		};

		const setVolume = (value: number) => {
			video.volume = Math.min(Math.max(Math.round(value * 100) / 100, 0), 1);
			video.muted = video.volume === 0;
			flash(`vol ${Math.round(video.volume * 100)} %`);
		};

		const toggleMute = () => {
			if (video.muted && video.volume === 0) video.volume = 0.5;
			video.muted = !video.muted;
			flash(video.muted ? 'mute' : `vol ${Math.round(video.volume * 100)} %`);
		};

		const changeSpeed = (step: number) => {
			const index = SPEEDS.indexOf(video.playbackRate);
			const next = SPEEDS[Math.min(Math.max((index === -1 ? 3 : index) + step, 0), SPEEDS.length - 1)];
			video.playbackRate = next;
			flash(`${next}x`);
		};

		const toggleFullscreen = () => {
			if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
			else if (document.fullscreenEnabled) root.requestFullscreen().catch(() => {});
			else (video as HTMLVideoElement & { webkitEnterFullscreen?: () => void }).webkitEnterFullscreen?.();
		};

		const togglePip = () => {
			if (pipBtn.hidden) return;
			if (document.pictureInPictureElement) document.exitPictureInPicture().catch(() => {});
			else video.requestPictureInPicture().catch(() => {});
		};

		const toggleHelp = (open = help.hidden) => {
			help.hidden = !open;
			helpBtn.setAttribute('aria-expanded', String(open));
			root.classList.toggle('has-help', open);
			showControls();
		};

		const frameStep = (direction: number) => {
			if (!video.paused) return;
			seek(video.currentTime + direction / 30);
		};

		// --- Rendering -------------------------------------------------------

		const render = () => {
			const total = video.duration || 0;
			const ratio = total ? video.currentTime / total : 0;
			played.style.transform = `scaleX(${ratio})`;
			thumb.style.left = `${ratio * 100}%`;
			current.textContent = format(video.currentTime);
			progress.setAttribute('aria-valuenow', String(Math.round(video.currentTime)));
			progress.setAttribute('aria-valuetext', `${format(video.currentTime)} / ${format(total)}`);
		};

		const renderBuffer = () => {
			const total = video.duration;
			if (!total || !video.buffered.length) return;
			// The range that holds the playhead is the one worth showing.
			let end = 0;
			for (let i = 0; i < video.buffered.length; i++) {
				if (video.buffered.start(i) <= video.currentTime + 0.5) end = video.buffered.end(i);
			}
			buffered.style.transform = `scaleX(${end / total})`;
		};

		const renderState = () => {
			root.toggleAttribute('data-paused', video.paused);
			root.toggleAttribute('data-ended', video.ended);
			const label = video.ended ? strings.replay : video.paused ? strings.play : strings.pause;
			toggles.forEach((button) => {
				button.setAttribute('aria-label', label);
				if (button.dataset.tip) button.dataset.tip = `${label} (k)`;
			});
			showControls();
		};

		const renderVolume = () => {
			const level = video.muted ? 0 : video.volume;
			root.dataset.volume = level === 0 ? 'muted' : level < 0.5 ? 'low' : 'high';
			volume.value = String(level);
			volume.style.setProperty('--fill', `${level * 100}%`);
			const label = video.muted ? strings.unmute : strings.mute;
			muteBtn.setAttribute('aria-label', label);
			muteBtn.dataset.tip = `${label} (m)`;
			saveVolume(video);
		};

		video.addEventListener('play', renderState);
		video.addEventListener('pause', renderState);
		video.addEventListener('ended', renderState);
		video.addEventListener('timeupdate', () => {
			if (!scrubbing) render();
			renderBuffer();
		});
		video.addEventListener('progress', renderBuffer);
		video.addEventListener('volumechange', renderVolume);
		video.addEventListener('ratechange', () => {
			speedBtn.textContent = `${video.playbackRate}x`;
		});
		video.addEventListener('loadedmetadata', () => {
			duration.textContent = format(video.duration);
			progress.setAttribute('aria-valuemax', String(Math.round(video.duration)));
			render();
		});
		video.addEventListener('waiting', () => root.classList.add('is-loading'));
		video.addEventListener('playing', () => root.classList.remove('is-loading'));
		video.addEventListener('canplay', () => root.classList.remove('is-loading'));
		video.addEventListener('error', () => {
			if (!video.src) return;
			root.classList.remove('is-loading');
			error.hidden = false;
		});
		renderVolume();

		// --- Pointer ---------------------------------------------------------

		video.addEventListener('click', togglePlay);
		video.addEventListener('dblclick', toggleFullscreen);
		toggles.forEach((button) => button.addEventListener('click', togglePlay));
		root.querySelectorAll<HTMLButtonElement>('[data-vp-skip]').forEach((button) => {
			button.addEventListener('click', () => skip(Number(button.dataset.vpSkip)));
		});
		muteBtn.addEventListener('click', toggleMute);
		volume.addEventListener('input', () => {
			video.volume = Number(volume.value);
			video.muted = video.volume === 0;
		});
		speedBtn.addEventListener('click', () => {
			const index = SPEEDS.indexOf(video.playbackRate);
			video.playbackRate = SPEEDS[(index + 1) % SPEEDS.length] ?? 1;
			// Cycling past 2x lands back on 0.25x: skip the slow ones.
			if (video.playbackRate < 1) video.playbackRate = 1;
		});
		helpBtn.addEventListener('click', () => toggleHelp());
		pipBtn.addEventListener('click', togglePip);
		fsBtn.addEventListener('click', toggleFullscreen);
		root.addEventListener('pointermove', showControls);
		root.addEventListener('pointerdown', showControls);
		root.addEventListener('mouseleave', () => {
			if (!video.paused) root.classList.add('is-idle');
		});

		const ratioAt = (event: PointerEvent) => {
			const rect = progress.getBoundingClientRect();
			return Math.min(Math.max((event.clientX - rect.left) / rect.width, 0), 1);
		};

		const preview = (event: PointerEvent) => {
			const ratio = ratioAt(event);
			const rect = progress.getBoundingClientRect();
			const tipHalf = tip.offsetWidth / 2;
			tip.textContent = format(ratio * (video.duration || 0));
			tip.style.left = `${Math.min(Math.max(ratio * rect.width, tipHalf), rect.width - tipHalf)}px`;
			hover.style.transform = `scaleX(${ratio})`;
			return ratio;
		};

		progress.addEventListener('pointermove', (event) => {
			const ratio = preview(event);
			if (scrubbing) {
				video.currentTime = ratio * (video.duration || 0);
				render();
			}
		});
		progress.addEventListener('pointerdown', (event) => {
			if (event.button !== 0 || !Number.isFinite(video.duration)) return;
			load();
			scrubbing = true;
			resumeAfterScrub = !video.paused;
			video.pause();
			progress.setPointerCapture(event.pointerId);
			root.classList.add('is-scrubbing');
			video.currentTime = preview(event) * video.duration;
			render();
		});
		const endScrub = () => {
			if (!scrubbing) return;
			scrubbing = false;
			root.classList.remove('is-scrubbing');
			if (resumeAfterScrub) video.play().catch(() => {});
		};
		progress.addEventListener('pointerup', endScrub);
		progress.addEventListener('pointercancel', endScrub);

		// --- Keyboard --------------------------------------------------------

		dialog.addEventListener('keydown', (event) => {
			if (event.ctrlKey || event.metaKey || event.altKey) return;
			const key = event.key;
			const target = event.target as HTMLElement;
			// Enter and Space on a focused button press that button.
			const onButton = target.matches('button, a');

			const actions: Record<string, () => void> = {
				k: togglePlay,
				j: () => skip(-10),
				l: () => skip(10),
				ArrowLeft: () => skip(-5),
				ArrowRight: () => skip(5),
				ArrowUp: () => setVolume(video.volume + 0.05),
				ArrowDown: () => setVolume(video.volume - 0.05),
				m: toggleMute,
				f: toggleFullscreen,
				i: togglePip,
				Home: () => seek(0),
				End: () => seek(video.duration),
				',': () => frameStep(-1),
				'.': () => frameStep(1),
				'<': () => changeSpeed(-1),
				'>': () => changeSpeed(1),
				'?': () => toggleHelp(),
			};
			if (!onButton) actions[' '] = togglePlay;

			let action = actions[key] ?? actions[key.toLowerCase()];
			if (!action && /^[0-9]$/.test(key)) action = () => seek((Number(key) / 10) * video.duration);
			if (!action) return;

			event.preventDefault();
			showControls();
			action();
		});

		// Esc closes the help first, then the window. Exiting fullscreen is the
		// browser's own job and never reaches the dialog.
		dialog.addEventListener('cancel', (event) => {
			if (!help.hidden) {
				event.preventDefault();
				toggleHelp(false);
			}
		});

		// --- Window ----------------------------------------------------------

		root.addEventListener('fullscreenchange', () => {
			const on = document.fullscreenElement === root;
			root.classList.toggle('is-fullscreen', on);
			const label = on ? strings.exitFullscreen : strings.fullscreen;
			fsBtn.setAttribute('aria-label', label);
			fsBtn.dataset.tip = `${label} (f)`;
			root.focus({ preventScroll: true });
		});

		dialog.querySelector('[data-vp-close]')!.addEventListener('click', () => dialog.close());
		// A click on the dimmed backdrop lands on the dialog itself.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
		dialog.addEventListener('close', () => {
			video.pause();
			toggleHelp(false);
			if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
		});

		return () => {
			load();
			dialog.showModal();
			root.focus({ preventScroll: true });
			video.play().catch(() => {
				// Autoplay refused (rare after a click): wait for the play button.
			});
		};
	}

	const init = () => {
		const stringsEl = document.querySelector('[data-vp-strings]');
		if (!stringsEl) return;
		const strings = JSON.parse(stringsEl.textContent ?? '{}') as Strings;

		document.querySelectorAll<HTMLDialogElement>('[data-video-modal]').forEach((dialog) => {
			if (dialog.dataset.ready) return;
			dialog.dataset.ready = 'true';
			const open = setup(dialog, strings);
			document.querySelectorAll<HTMLElement>(`[data-video-open="${dialog.id}"]`).forEach((trigger) => {
				trigger.addEventListener('click', (event) => {
					if (event.ctrlKey || event.metaKey || event.shiftKey || event.button !== 0) return;
					event.preventDefault();
					open();
				});
			});
		});
	};

	document.addEventListener('astro:page-load', init);
</script>

<style>
	/* The picture is always dark, whatever the site theme, so the player
	   chrome on top of it keeps fixed colors. */
	.vm {
		--vp-accent: #5fd39a;
		--vp-fg: #e9eaed;
		--vp-muted: #a1a6b0;
		--vp-panel: rgba(11, 12, 15, 0.92);

		width: min(1100px, calc(100vw - 2rem));
		max-width: none;
		max-height: calc(100dvh - 2rem);
		margin: auto;
		padding: 0;
		border: none;
		background: transparent;
		color: var(--text);
		overflow: visible;
	}

	.vm::backdrop {
		background: color-mix(in srgb, var(--bg) 70%, transparent);
		backdrop-filter: blur(6px);
	}

	.vm[open] {
		animation: vm-in 0.22s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.vm[open]::backdrop {
		animation: vm-fade 0.22s ease;
	}

	@keyframes vm-in {
		from {
			opacity: 0;
			transform: translateY(12px) scale(0.98);
		}
	}

	@keyframes vm-fade {
		from {
			opacity: 0;
		}
	}

	:global(html:has(dialog.vm[open])) {
		overflow: hidden;
	}

	.vm-window {
		background: var(--bg-elevated);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius);
		box-shadow: 6px 6px 0 color-mix(in srgb, var(--accent) 40%, transparent), 0 24px 60px rgba(0, 0, 0, 0.45);
		overflow: hidden;
	}

	.vm-bar span {
		padding-right: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.vm-close {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.2rem 0.45rem;
		margin: -0.3rem -0.4rem -0.3rem 0;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		background: none;
		color: var(--text-muted);
		font: inherit;
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
	}

	.vm-close:hover {
		color: var(--text);
		border-color: var(--border-strong);
		background: var(--bg-subtle);
	}

	.vm-close kbd {
		font-family: var(--font-mono);
		font-size: 0.7rem;
	}

	/* --- Player ------------------------------------------------------------ */

	.vp {
		position: relative;
		aspect-ratio: 16 / 9;
		max-height: calc(100dvh - 2rem - 42px);
		margin: 0 auto;
		background: #000;
		color: var(--vp-fg);
		font-family: var(--font-mono);
		overflow: hidden;
		outline: none;
		user-select: none;
		-webkit-user-select: none;
	}

	.vp.is-fullscreen {
		max-height: none;
		aspect-ratio: auto;
	}

	.vp video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		background: #000;
	}

	.vp.is-idle {
		cursor: none;
	}

	/* Big play button: same offset shadow as the primary buttons of the site. */
	.vp-big {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 76px;
		height: 76px;
		translate: -50% -50%;
		border: 1px solid var(--vp-accent);
		border-radius: var(--radius);
		background: var(--vp-panel);
		color: var(--vp-accent);
		box-shadow: 4px 4px 0 var(--vp-accent);
		cursor: pointer;
		transition: opacity 0.2s ease, transform 0.15s ease, box-shadow 0.15s ease;
	}

	.vp-big:hover {
		transform: translate(-1px, -1px);
		box-shadow: 5px 5px 0 var(--vp-accent);
	}

	.vp-big:active {
		transform: translate(2px, 2px);
		box-shadow: 2px 2px 0 var(--vp-accent);
	}

	.vp-big svg {
		width: 34px;
		height: 34px;
	}

	.vp:not([data-paused]) .vp-big,
	.vp.is-scrubbing .vp-big,
	.vp.has-help .vp-big {
		opacity: 0;
		pointer-events: none;
