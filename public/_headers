# HTTP headers for Cloudflare Workers static assets.
# Every rule that matches a URL applies, so the catch-all at the bottom adds the
# security headers everywhere without conflicting with the cache rules above.

# Astro fingerprints everything it emits under /_astro/, so it can be cached
# forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

# Pages are prefetched on load. A revalidation on click would cost a full round
# trip and undo the prefetch. A short fresh window bridges prefetch -> click;
# stale-while-revalidate keeps later visits instant while refreshing in the
# background. One line per route so they never overlap with /_astro/* (two
# Cache-Control values would be joined). Add a block here when you add a page.
/
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/en*
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/about*
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/projects*
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/contact*
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

# Videos are same-origin files (media-src). form.noam.ovh receives the contact form. challenges.cloudflare.com serves the
# Turnstile script and its iframe on the contact page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self' https://form.noam.ovh; frame-src https://challenges.cloudflare.com; form-action 'self' https://form.noam.ovh; base-uri 'self'; frame-ancestors 'none'; object-src 'none'
