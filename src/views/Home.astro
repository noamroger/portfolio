---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StackList from '../components/StackList.astro';
import GitHubStats from '../components/github/GitHubStats.astro';
import GitHubRecent from '../components/github/GitHubRecent.astro';
import { getI18n } from '../i18n';
import WindowBar from '../components/WindowBar.astro';
import { projects } from '../data/projects';

const { t, path } = getI18n(Astro.url.pathname);

// The three cards at the top of the Projects page, so the home page carries
// real copy and links through to the full list.
const featured = projects.slice(0, 3).map((project) => ({
	...t.projects.items[project.key],
	// Projects without a public repository (the homelab) link to the Projects page.
	href: project.github ?? path('/projects/'),
	external: project.github !== null,
}));
---

<Layout title={t.home.metaTitle} description={t.home.metaDescription}>
	<Navbar />
	<main id="main" class="home">
		<section class="hero">
			<div class="hero-bg dot-grid" aria-hidden="true"></div>
			<div class="container hero-grid">
				<div class="hero-text">
					<span class="eyebrow">{t.home.eyebrow}</span>
					<h1>{t.home.title}</h1>
					<p class="hero-description">{t.home.description}</p>
					<div class="hero-actions">
						<a href={path('/projects/')} class="btn btn-primary">{t.home.ctaProjects}</a>
						<a href={path('/contact/')} class="btn btn-secondary">{t.home.ctaContact}</a>
					</div>
				</div>

				<aside class="card terminal" aria-labelledby="profile-title">
					<WindowBar title="noam@roger: ~" />
					<div class="terminal-body" data-terminal>
						<p class="terminal-cmd" aria-hidden="true"><span class="t-prompt">$</span> <span class="typed">kubectl get developer noam-roger -o yaml</span></p>
						<h2 class="sr-only" id="profile-title">{t.home.profile.title}</h2>
						<dl class="yaml">
							<div style="--i: 0" class="yaml-line" aria-hidden="true"><span class="t-key">kind</span>: <span class="t-kw">Developer</span></div>
							<div style="--i: 1" class="yaml-line" aria-hidden="true"><span class="t-key">metadata</span>:</div>
							<div style="--i: 2" class="yaml-line yaml-indent" aria-hidden="true"><span class="t-key">name</span>: <span class="t-str">noam-roger</span></div>
							<div style="--i: 3" class="yaml-line" aria-hidden="true"><span class="t-key">spec</span>:</div>
							{t.home.profile.rows.map((row, i) => (
								<div class="yaml-line yaml-indent" style={`--i: ${i + 4}`}>
									<dt><span class="t-key" aria-hidden="true">{row.key}</span><span class="sr-only">{row.label}</span><span aria-hidden="true">: </span></dt>
									<dd><span class="t-str">{row.value}</span> <span class="t-comment" aria-hidden="true"># {row.label}</span></dd>
								</div>
							))}
							<div style="--i: 9" class="yaml-line" aria-hidden="true"><span class="t-key">status</span>:</div>
						</dl>
						<p class="terminal-status" style="--i: 10">
							<span class="status-dot" aria-hidden="true"></span>
							{t.home.profile.status}
						</p>
						<div class="terminal-output" data-terminal-output aria-live="polite"></div>
						<form class="terminal-cmd terminal-last" style="--i: 11" data-terminal-form>
							<label class="t-prompt" for="terminal-input">guest@noamroger.fr:~$</label>
							<span class="terminal-field">
								<input
									id="terminal-input"
									class="terminal-input"
									data-terminal-input
									type="text"
									placeholder=" "
									autocomplete="off"
									autocorrect="off"
									autocapitalize="off"
									spellcheck="false"
									enterkeyhint="go"
								/>
								<span class="cursor" aria-hidden="true"></span>
							</span>
						</form>
					</div>
				</aside>
			</div>
			<div class="container hero-stats">
				<GitHubStats />
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="section-head">
					<div>
						<h2>{t.home.focusTitle}</h2>
						<p>{t.home.focusIntro}</p>
					</div>
				</div>
				<div class="focus-grid">
					{t.home.focus.map((item, i) => (
						<article class="focus-item">
							<span class="focus-index">{String(i + 1).padStart(2, '0')}</span>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="section-head">
					<div>
						<h2>{t.home.featuredTitle}</h2>
						<p>{t.home.featuredIntro}</p>
					</div>
					<a href={path('/projects/')} class="link-arrow">{t.home.featuredCta}</a>
				</div>
				<div class="featured-grid">
					{featured.map((project) => (
						<a class="card featured-card" href={project.href} target={project.external ? '_blank' : undefined} rel={project.external ? 'noopener noreferrer' : undefined}>
							<span class="featured-context">{project.context}</span>
							<h3>{project.title}</h3>
							<p>{project.description}</p>
							<div class="tag-list">
								{project.tech.map((tech) => <span class="tag">{tech}</span>)}
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		<GitHubRecent />

		<section class="section">
			<div class="container">
				<div class="section-head">
					<div>
						<h2>{t.home.stackTitle}</h2>
						<p>{t.home.stackIntro}</p>
					</div>
				</div>
				<StackList />
			</div>
		</section>

		<section class="section cta-section">
			<div class="container">
				<div class="card cta">
					<div>
						<h2>{t.home.ctaTitle}</h2>
						<p>{t.home.ctaText}</p>
					</div>
					<a href={path('/contact/')} class="btn btn-primary">{t.home.ctaButton}</a>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script src="../scripts/terminal.ts"></script>

<style>
	.home {
		flex: 1;
	}

	.hero {
		position: relative;
		padding: 6rem 0 5rem;
		border-bottom: 1px solid var(--border);
		overflow: hidden;
	}

	/* Under the December snow (z-index -1), like the page header grid. */
	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: -2;
		-webkit-mask-image: radial-gradient(ellipse 70% 80% at 75% 40%, #000 20%, transparent 75%);
		mask-image: radial-gradient(ellipse 70% 80% at 75% 40%, #000 20%, transparent 75%);
		pointer-events: none;
	}

	.hero-grid,
	.hero-stats {
		position: relative;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		gap: 4rem;
		align-items: center;
	}

	.hero-text h1 {
		font-size: clamp(2.1rem, 4.4vw, 3.1rem);
		line-height: 1.12;
		letter-spacing: -0.03em;
		margin-bottom: 1.5rem;
		max-width: 20ch;
	}

	.hero-description {
		font-size: 1.1rem;
		color: var(--text-secondary);
		max-width: 56ch;
		margin-bottom: 2rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.terminal {
		overflow: hidden;
		font-family: var(--font-mono);
		box-shadow: var(--shadow), 0 24px 48px -24px rgba(0, 0, 0, 0.35);
		transform: rotate(0.6deg);
		transition: transform 0.3s ease;
	}

	.terminal:hover {
		transform: rotate(0deg);
	}

	.terminal-body {
		padding: 1.15rem 1.25rem 1.25rem;
		font-size: 0.78rem;
		line-height: 1.75;
	}

	.terminal-cmd {
		color: var(--text);
		margin-bottom: 0.5rem;
	}

	.terminal-last {
		display: flex;
		align-items: center;
		gap: 1ch;
		margin: 0.75rem 0 0;
	}

	/* Interactive prompt (src/scripts/terminal.ts). */
	.terminal-body {
		overflow-y: auto;
		cursor: text;
	}

	.terminal-field {
		position: relative;
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: center;
	}

	.terminal-input {
		width: 100%;
		min-width: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		outline: 0;
		background: transparent;
		color: var(--text);
		font: inherit;
		line-height: inherit;
		caret-color: var(--accent);
		caret-shape: block;
	}

	/* The block cursor stands in for the caret until the prompt is used. */
	.terminal-field .cursor {
		position: absolute;
		left: 0;
		margin: 0;
		pointer-events: none;
	}

	.terminal-input:focus + .cursor,
	.terminal-input:not(:placeholder-shown) + .cursor {
		display: none;
	}

	/* iOS zooms the page when a focused field is under 16px. */
	@media (pointer: coarse) {
		.terminal-input {
			font-size: 16px;
			height: 1.75em;
		}
	}

	.terminal-output :global(pre) {
		margin: 0;
		font: inherit;
		color: var(--text-secondary);
		white-space: pre;
		overflow-x: auto;
		scrollbar-width: thin;
	}

	.terminal-output :global(.terminal-echo),
	.terminal-output :global(.terminal-wrap) {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.terminal-output :global(.terminal-echo) {
		margin-top: 0.75rem;
		color: var(--text);
	}

	.terminal-output :global(.t-prompt) {
		color: var(--accent);
		font-weight: 600;
	}

	.t-prompt {
		color: var(--accent);
		font-weight: 600;
	}

	.t-key {
		color: var(--syntax-key);
	}

	.t-str {
		color: var(--syntax-string);
	}

	.t-kw {
		color: var(--syntax-keyword);
	}

	.t-comment {
		color: var(--text-muted);
		font-style: italic;
	}

	.yaml-line {
		color: var(--text-secondary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.yaml-line dt,
	.yaml-line dd {
		display: inline;
	}

	.yaml-indent {
		padding-left: 2ch;
	}



	/* Boot sequence: the command types itself, then the output prints line by line. */
	.typed {
		display: inline-block;
		vertical-align: bottom;
		overflow: hidden;
		white-space: nowrap;
		width: 0;
		animation: type 1.1s steps(40, end) 0.4s forwards;
	}

	@keyframes type {
		to { width: 40ch; }
	}

	.yaml-line,
	.terminal-status,
	.terminal-last {
		opacity: 0;
		animation: print 0.25s ease forwards;
		animation-delay: calc(1.6s + var(--i, 0) * 0.09s);
	}

	@keyframes print {
		from { opacity: 0; transform: translateY(3px); }
		to { opacity: 1; transform: none; }
	}

	.hero-text > * {
		opacity: 0;
		animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
	}

	.hero-text > :nth-child(2) { animation-delay: 0.08s; }
	.hero-text > :nth-child(3) { animation-delay: 0.16s; }
	.hero-text > :nth-child(4) { animation-delay: 0.24s; }

	@keyframes rise {
		from { opacity: 0; transform: translateY(14px); }
		to { opacity: 1; transform: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		.typed {
			width: auto;
			animation: none;
		}

		.yaml-line,
		.terminal-status,
		.terminal-last,
		.hero-text > * {
			opacity: 1;
			animation: none;
		}
	}

	.terminal-status {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-left: 2ch;
		padding: 0.6rem 0.8rem;
		border-radius: var(--radius-sm);
		border: 1px dashed color-mix(in srgb, var(--success) 50%, transparent);
		background: color-mix(in srgb, var(--success) 8%, transparent);
		font-family: var(--font-sans);
		font-size: 0.85rem;
		line-height: 1.45;
		color: var(--text);
	}

	.focus-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid var(--border);
	}

	.focus-item {
		padding: 1.75rem 2rem 0.5rem 0;
	}

	.focus-item + .focus-item {
		padding-left: 2rem;
		border-left: 1px solid var(--border);
	}

	.focus-item h3 {
		transition: color 0.15s ease;
	}

	.focus-item:hover h3 {
		color: var(--accent);
	}

	.focus-index {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.focus-item h3 {
		font-size: 1.1rem;
		margin-bottom: 0.6rem;
	}

	.focus-item p {
		color: var(--text-secondary);
		font-size: 0.95rem;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.featured-card {
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		color: var(--text);
		transition: border-color 0.15s ease;
	}

	.featured-card {
		transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
	}

	.featured-card:hover {
		color: var(--text);
		border-color: var(--accent);
		transform: translate(-2px, -2px);
		box-shadow: 4px 4px 0 color-mix(in srgb, var(--accent) 45%, transparent);
	}

	.featured-card:hover h3 {
		color: var(--accent);
	}

	.featured-context {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
		margin-bottom: 0.75rem;
	}

	.featured-card h3 {
		font-size: 1.1rem;
		margin-bottom: 0.6rem;
		transition: color 0.15s ease;
	}

	.featured-card p {
		color: var(--text-secondary);
		font-size: 0.925rem;
		margin-bottom: 1.25rem;
		flex: 1;
	}

	.cta-section {
		padding-top: 0;
		border-top: none !important;
	}

	.cta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
		padding: 2rem 2.25rem;
	}

	.cta h2 {
		font-size: 1.35rem;
		margin-bottom: 0.4rem;
	}

	.cta p {
		color: var(--text-secondary);
		max-width: 60ch;
	}

	.cta .btn {
		flex-shrink: 0;
	}

	@media (max-width: 960px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.featured-grid,
		.focus-grid {
			grid-template-columns: 1fr;
		}

		.focus-item,
		.focus-item + .focus-item {
			padding: 1.5rem 0;
			border-left: none;
		}

		.focus-item + .focus-item {
			border-top: 1px solid var(--border);
		}
	}

	@media (max-width: 768px) {
		.hero {
			padding: 3rem 0;
		}

		.hero-actions .btn {
			flex: 1;
		}

		.terminal {
			transform: none;
		}

		.t-comment {
			display: none;
		}

		.cta {
			flex-direction: column;
			align-items: flex-start;
			padding: 1.5rem;
		}
	}
</style>
