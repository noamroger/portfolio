	.vp-help-title span {
		color: var(--vp-accent);
	}

	.vp-help dl {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.4rem 1.5rem;
		font-size: 0.75rem;
	}

	.vp-help dl > div {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
	}

	.vp-help dt {
		flex: 0 0 6.5rem;
	}

	.vp-help dd {
		color: var(--vp-muted);
		font-family: var(--font-sans);
	}

	kbd {
		font-family: var(--font-mono);
	}

	.vp-help kbd {
		display: inline-block;
		padding: 0.05rem 0.4rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-bottom-width: 2px;
		border-radius: 4px;
		color: var(--vp-accent);
		font-size: 0.7rem;
		white-space: nowrap;
