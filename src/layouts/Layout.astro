---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import { getI18n, locales, publicUrl, socialProfiles, stripLocale, techStack } from '../i18n';
import { THEME_KEY } from '../i18n/preference';
import Shortcuts from '../components/Shortcuts.astro';
import '../styles/snow.css';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
	/** schema.org type of this page, e.g. AboutPage or ContactPage. */
	pageType?: string;
	/** Extra schema.org nodes appended to the page graph. */
	schema?: Record<string, unknown>[];
}

const { t, locale, origin, contactEmail } = getI18n(Astro.url.pathname);

const {
	title,
	description = t.meta.description,
	noindex = false,
	pageType = 'WebPage',
	schema = [],
} = Astro.props;

const path = Astro.url.pathname;
// The address the visitor sees: English pages are built under /en but served
// at the root of their own domain.
const canonical = publicUrl(path, locale);
const fullTitle = title;
const ogImage = `${origin}/og-image.png`;

// One @graph per page rather than scattered snippets: the nodes reference each
// other by @id, so a crawler reading any page gets the whole picture.
const personId = `${origin}/#person`;
const businessId = `${origin}/#business`;
const siteId = `${origin}/#website`;

const address = {
	'@type': 'PostalAddress',
	addressLocality: 'Le Mans',
	addressCountry: 'FR',
};

// Breadcrumbs: the site is flat, so it is always Home > current page.
const crumbLabels: Record<string, string> = {
	'/about': t.nav.about,
	'/projects': t.nav.projects,
	'/contact': t.nav.contact,
};
const basePath = stripLocale(path);
const crumbKey = basePath !== '/' && basePath.endsWith('/') ? basePath.slice(0, -1) : basePath;
const crumbLabel = crumbLabels[crumbKey];

const breadcrumb = crumbLabel
	? {
			'@type': 'BreadcrumbList',
			'@id': `${canonical}#breadcrumb`,
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: t.nav.home, item: `${origin}/` },
				{ '@type': 'ListItem', position: 2, name: crumbLabel, item: canonical },
			],
		}
	: null;

const graph = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': personId,
			name: 'Noam Roger',
			jobTitle: t.meta.jobTitle,
			description: t.meta.description,
			url: `${origin}/`,
			image: ogImage,
			email: `mailto:${contactEmail}`,
			address,
			knowsAbout: techStack,
			sameAs: socialProfiles,
		},
		{
			'@type': 'ProfessionalService',
			'@id': businessId,
			name: 'Noam Roger',
			description: t.meta.description,
			url: `${origin}/`,
			image: ogImage,
			email: `mailto:${contactEmail}`,
			address,
			areaServed: { '@type': 'Country', name: 'France' },
			founder: { '@id': personId },
			knowsLanguage: ['fr', 'en'],
			sameAs: socialProfiles,
		},
		{
			'@type': 'WebSite',
			'@id': siteId,
			name: 'Noam Roger',
			url: `${origin}/`,
			inLanguage: t.htmlLang,
			publisher: { '@id': personId },
		},
		{
			'@type': pageType,
			'@id': canonical,
			url: canonical,
			name: title,
			description,
			inLanguage: t.htmlLang,
			isPartOf: { '@id': siteId },
			about: { '@id': personId },
			primaryImageOfPage: ogImage,
			...(breadcrumb ? { breadcrumb: { '@id': breadcrumb['@id'] } } : {}),
		},
		...(breadcrumb ? [breadcrumb] : []),
		...schema,
	],
};
// A word for whoever reads the source, kept in the built page on purpose and
// written in the language of the page.
const sourceNote =
	locale === 'en'
		? `<!--
  Hello, view-source reader.

  The readable version of this page lives at https://github.com/noamroger/portfolio
  Plain-text files worth a look: /humans.txt, /robots.txt, /.well-known/security.txt
  The home page terminal knows more commands than 'help' admits.

  flag{view_source_never_dies}
-->`
		: `<!--
  Bonjour à toi qui lis le code source.

  La version lisible de cette page est sur https://github.com/noamroger/portfolio
  Des fichiers texte à aller voir : /humans.txt, /robots.txt, /.well-known/security.txt
  Le terminal de la page d'accueil connaît plus de commandes que 'help' ne l'avoue.

  flag{view_source_never_dies}
-->`;
---

<!doctype html>
<html lang={t.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<Fragment set:html={sourceNote} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0b0c0f" />
		<meta name="color-scheme" content="dark light" />
		{/*
			Dark is the default; a visitor who picked light with the navbar toggle
			gets it before the first paint. The client router swaps <html>
			attributes on every navigation, so the theme is reapplied after each swap.
		*/}
		<script is:inline define:vars={{ key: THEME_KEY }}>
			const applyTheme = () => {
				let theme = 'dark';
				try {
					if (localStorage.getItem(key) === 'light') theme = 'light';
				} catch {
					// Storage can be blocked: stay on the default.
				}
				document.documentElement.dataset.theme = theme;
				document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'light' ? '#f4efe4' : '#0b0c0f');
			};
			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
		</script>

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Noam Roger" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Noam Roger" />
		<meta property="og:locale" content={t.meta.ogLocale} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale:alternate" content={t.meta.ogLocaleAlternate} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t.meta.ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

		{noindex ? (
			<meta name="robots" content="noindex, follow" />
		) : (
			<Fragment>
				{/* Without max-image-preview, Google caps previews at a thumbnail. */}
				<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
				<link rel="canonical" href={canonical} />
				<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
				{locales.map((code) => (
					<link rel="alternate" hreflang={code} href={publicUrl(path, code)} />
				))}
				<link rel="alternate" hreflang="x-default" href={publicUrl(path, 'fr')} />
			</Fragment>
		)}

		{!noindex && (
			<script type="application/ld+json" set:html={JSON.stringify(graph)} />
		)}

		<ClientRouter />
	</head>
	<body>
		<a href="#main" class="skip-link">{t.a11y.skipToContent}</a>
		<slot />
		<Shortcuts />
		<script>
			const selector = '.page-header > .container, .section-head, .focus-item, .featured-card, .stack-row, .cta, .project-card, .timeline li, .approach li, .side-card, .contact-info, .contact-form-wrapper';

			const initReveal = () => {
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				const observer = new IntersectionObserver((entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				}, { rootMargin: '0px 0px -8% 0px' });

				document.querySelectorAll<HTMLElement>(selector).forEach((el) => {
					// Siblings in the same row come in one after the other.
					const index = Array.prototype.indexOf.call(el.parentElement?.children ?? [], el);
					el.style.setProperty('--reveal-delay', `${Math.min(index, 5) * 70}ms`);
					el.classList.add('reveal');
					observer.observe(el);
				});
			};

			document.addEventListener('astro:page-load', initReveal);
		</script>
		{/* A word for whoever opens the DevTools. A module runs once per visit, not on every navigation. */}
		<script src="../scripts/devtools-hello.ts"></script>
		{/* Anonymous page view counter: no cookie, nothing stored in the browser. */}
		<script src="../scripts/stats.ts"></script>
		{/* December snowfall: does nothing the rest of the year. */}
		<script src="../scripts/snow.ts"></script>
	</body>
</html>

<style is:global>
	/* Design tokens. Dark is the default theme, light is opt-in. */
	:root {
		color-scheme: dark;
		--bg: #0b0c0f;
		--bg-elevated: #121418;
		--bg-subtle: #181b20;
		--border: #23262d;
		--border-strong: #30343c;
		--text: #e9eaed;
		--text-secondary: #a1a6b0;
		--text-muted: #868b95;
		--accent: #5fd39a;
		--accent-strong: #8ae3b6;
		--accent-soft: rgba(95, 211, 154, 0.12);
		--syntax-key: #82aaff;
		--syntax-string: #e5c07b;
		--syntax-keyword: #c792ea;
		--dot-grid: rgba(255, 255, 255, 0.07);
		--on-accent: #0b0c0f;
		--success: #4cc38a;
		--danger: #f07178;
		--shadow: 0 1px 2px rgba(0, 0, 0, 0.4);

		--font-sans: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		--font-mono: 'JetBrains Mono Variable', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
		--radius: 10px;
		--radius-sm: 6px;
	}

	:root[data-theme='light'] {
		color-scheme: light;
		--bg: #f4efe4;
		--bg-elevated: #faf6ee;
		--bg-subtle: #ebe4d5;
		--border: #e0d7c5;
		--border-strong: #cfc4ae;
		--text: #2b2721;
		--text-secondary: #5a5246;
		--text-muted: #6b6253;
		--accent: #0e7c50;
		--accent-strong: #095c3b;
		--accent-soft: rgba(14, 124, 80, 0.08);
		--syntax-key: #2453c2;
		--syntax-string: #9a5b00;
		--syntax-keyword: #8b3fb8;
		--dot-grid: rgba(60, 45, 20, 0.1);
		--on-accent: #ffffff;
		--success: #16855a;
		--danger: #c4323a;
		--shadow: 0 1px 2px rgba(60, 45, 20, 0.06);
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		/* Stops iOS inflating body text when the phone is turned sideways. */
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
	}

	a,
	button {
		-webkit-tap-highlight-color: var(--accent-soft);
	}

	body {
		font-family: var(--font-sans);
		font-size: 1rem;
		font-feature-settings: 'cv11', 'ss01';
		background-color: var(--bg);
		color: var(--text);
		line-height: 1.6;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	h1,
	h2,
	h3 {
		letter-spacing: -0.02em;
		line-height: 1.2;
		font-weight: 600;
	}

	a {
		color: var(--accent);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	a:hover {
		color: var(--accent-strong);
	}

	::selection {
		background: var(--accent);
		color: var(--on-accent);
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 2px;
	}

	/* Keeps [hidden] winning over component display rules. */
	[hidden] {
		display: none !important;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.skip-link {
		position: absolute;
		left: 1rem;
		top: -100%;
		z-index: 200;
		padding: 0.75rem 1.25rem;
		border-radius: 0 0 var(--radius-sm) var(--radius-sm);
		background: var(--bg-elevated);
		border: 1px solid var(--accent);
		color: var(--text);
		font-weight: 600;
	}

	.skip-link:focus {
		top: 0;
	}

	.container {
		width: 100%;
		max-width: 1120px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	@media (max-width: 768px) {
		.container {
			padding: 0 1rem;
		}
	}

	/* Shared building blocks, used by every page. */

	.eyebrow {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.eyebrow::before {
		content: '$ ';
		color: var(--text-muted);
	}

	.page-header {
		position: relative;
		padding: 5rem 0 3rem;
		border-bottom: 1px solid var(--border);
	}

	/*
	 * Dot grid, faded towards the left so the title stays on a plain background.
	 * Drawn on a layer at z-index -2 rather than on the header itself, so the
	 * December snow (z-index -1) falls in front of it but behind the text.
	 */
	.page-header::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -2;
		background:
			linear-gradient(90deg, var(--bg) 35%, color-mix(in srgb, var(--bg) 40%, transparent) 100%),
			radial-gradient(var(--dot-grid) 1px, transparent 1px);
		background-size: auto, 22px 22px;
		pointer-events: none;
	}

	.page-header > * {
		position: relative;
	}

	.page-header h1 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		max-width: 22ch;
		margin-bottom: 1rem;
	}

	.page-header p {
		font-size: 1.125rem;
		color: var(--text-secondary);
		max-width: 60ch;
	}

	.section {
		padding: 5rem 0;
	}

	.section ~ .section {
		border-top: 1px solid var(--border);
	}

	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 2rem;
		margin-bottom: 2.5rem;
	}

	.section-head h2 {
		font-size: 1.75rem;
		margin-bottom: 0.5rem;
	}

	/* Markdown-style heading marker: a small nod to where the content lives. */
	.section-head h2::before {
		content: '#';
		margin-right: 0.6rem;
		font-family: var(--font-mono);
		font-weight: 400;
		color: var(--accent);
	}

	.section-head p {
		color: var(--text-secondary);
		max-width: 60ch;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.7rem 1.25rem;
		border-radius: var(--radius-sm);
		border: 1px solid transparent;
		font: inherit;
		font-size: 0.95rem;
		font-weight: 500;
		line-height: 1.4;
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}

	.btn-primary {
		background: var(--text);
		color: var(--bg);
		box-shadow: 3px 3px 0 var(--accent);
		transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
	}

	.btn-primary:hover {
		color: var(--bg);
		transform: translate(-1px, -1px);
		box-shadow: 4px 4px 0 var(--accent);
	}

	.btn-primary:active {
		transform: translate(2px, 2px);
		box-shadow: 1px 1px 0 var(--accent);
	}

	.btn-secondary {
		background: transparent;
		color: var(--text);
		border-color: var(--border-strong);
	}

	.btn-secondary:hover {
		background: var(--bg-subtle);
		color: var(--text);
	}

	.btn:disabled {
		opacity: 0.6;
		cursor: progress;
	}

	.link-arrow {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-weight: 500;
		white-space: nowrap;
	}

	.link-arrow::after {
		content: '→';
		transition: transform 0.15s ease;
	}

	.link-arrow:hover::after {
		transform: translateX(3px);
	}

	.tag {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1.5;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		background: var(--bg-subtle);
		border: 1px solid var(--border);
		color: var(--text-secondary);
	}

	.tag-learning {
		border-style: dashed;
		border-color: var(--accent);
		color: var(--accent);
		background: transparent;
	}

	.tag:hover {
		color: var(--text);
		border-color: var(--border-strong);
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.card {
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
	}

	/* Faint dot grid, like graph paper, faded out towards the edges. */
	.dot-grid {
		background-image: radial-gradient(var(--dot-grid) 1px, transparent 1px);
		background-size: 22px 22px;
	}

	/* Fake window chrome for terminal-style cards (see WindowBar.astro). The two
	   outer columns always share the same width, so the title stays centred on
	   the bar whatever sits on either side. */
	.window-bar {
		display: grid;
		grid-template-columns: minmax(max-content, 1fr) minmax(0, auto) minmax(max-content, 1fr);
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--border);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.window-controls {
		grid-column: 1;
		justify-self: start;
		display: flex;
		gap: 8px;
		cursor: default;
		user-select: none;
		-webkit-user-select: none;
	}

	.window-controls i {
		display: grid;
		place-items: center;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.12);
	}

	.window-controls .wc-close { background: #ff5f56; }
	.window-controls .wc-min { background: #ffbd2e; }
	.window-controls .wc-max { background: #27c93f; }

	/* Glyphs: hidden at rest, all three shown together when the pointer is over
	   the group, the one under the pointer a little stronger. */
	/* 8px in a 12px light: 2px on every side, so the glyph lands on whole
	   pixels and stays dead centre. */
	.window-controls svg {
		display: block;
		width: 8px;
		height: 8px;
		fill: none;
		stroke: #000;
		stroke-width: 1.5;
		stroke-linecap: round;
		opacity: 0;
		transition: opacity 0.15s ease;
	}

	/* Filled shapes look heavier than strokes at the same opacity: the
	   triangles are lightened to sit level with the cross and the dash. */
	.window-controls .wc-max svg {
		fill: #000;
		fill-opacity: 0.7;
		stroke: none;
	}

	.window-controls:hover svg { opacity: 0.55; }
	.window-controls i:hover svg { opacity: 0.85; }

	.window-title {
		grid-column: 2;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		text-align: center;
	}

	.window-bar > :nth-child(n + 3) {
		grid-column: 3;
		justify-self: end;
	}

	.cursor {
		display: inline-block;
		width: 0.55em;
		height: 1.05em;
		margin-left: 2px;
		vertical-align: text-bottom;
		background: var(--accent);
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% { opacity: 0; }
	}

	.status-dot {
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--success);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 20%, transparent);
		flex-shrink: 0;
	}

	@media (max-width: 768px) {
		.page-header {
			padding: 3rem 0 2rem;
		}

		.section {
			padding: 3.5rem 0;
		}

		.section-head {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}

		.btn {
			min-height: 44px;
		}
	}

	/* Scroll reveal: the class is only added by script, so nothing stays hidden without JS. */
	.reveal:not(.is-visible) {
		opacity: 0;
	}

	/* An animation rather than a transition, so it never fights hover effects. */
	.reveal.is-visible {
		animation: reveal 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) var(--reveal-delay, 0s) backwards;
	}

	@keyframes reveal {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
	}

