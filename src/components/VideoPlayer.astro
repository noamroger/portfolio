	/* Icon swaps driven by the state attributes on .vp. */
	.ic-pause,
	.ic-replay,
	.ic-muted,
	.ic-fs-exit {
		display: none;
	}

	.vp:not([data-paused]) .vp-btn .ic-play {
		display: none;
	}

	.vp:not([data-paused]) .vp-btn .ic-pause {
		display: block;
	}

	.vp[data-ended] .ic-play,
	.vp[data-ended] .ic-pause {
