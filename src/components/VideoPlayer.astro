	/* --- Controls -------------------------------------------------------------- */

	.vp-controls {
		position: absolute;
		inset: auto 0 0;
		padding: 3.5rem 0.75rem 0.4rem;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.92), rgba(0, 0, 0, 0.7) 45%, transparent);
		transition: opacity 0.25s ease, translate 0.25s ease;
	}

	.vp.is-idle .vp-controls {
		opacity: 0;
		translate: 0 6px;
