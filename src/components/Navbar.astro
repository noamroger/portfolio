---
import { getI18n, locales, localizedPath, stripLocale } from '../i18n';

const { locale, t, path } = getI18n(Astro.url.pathname);
const pathname = stripLocale(Astro.url.pathname).replace(/\/$/, "");
const currentPage = pathname === "" ? "/" : pathname;

// The other language lives at the same path, under /en for English. From the
// 404 page there is nothing to match over there, so point at the home page.
const otherLocale = locales.find((code) => code !== locale)!;
const otherHref = localizedPath(currentPage === '/404' ? '/' : Astro.url.pathname, otherLocale);

const links = [
	{ href: '/', key: '/', label: t.nav.home },
	{ href: '/about/', key: '/about', label: t.nav.about },
	{ href: '/projects/', key: '/projects', label: t.nav.projects },
	{ href: '/contact/', key: '/contact', label: t.nav.contact },
];
---

<header class="navbar">
	<div class="container navbar-content">
		<a href={path('/')} class="brand" aria-label={t.nav.logoLabel}>
			<span class="brand-prompt" aria-hidden="true">~/</span><span class="brand-name">noam<span class="brand-dot">.</span>roger</span>
		</a>
		<nav class="nav-links" aria-label="Navigation">
			{links.map((link) => (
				<a href={path(link.href)} aria-current={currentPage === link.key ? 'page' : undefined}>{link.label}</a>
			))}
		</nav>
		<div class="nav-tools">
			<button
				type="button"
				class="tool theme-toggle"
				data-theme-toggle
				data-label-light={t.nav.themeToLight}
				data-label-dark={t.nav.themeToDark}
				aria-label={t.nav.themeToLight}
				title={t.nav.themeToLight}
			>
				<svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
				</svg>
				<svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
			</button>
			<a
				class="tool lang-switch"
				data-astro-prefetch="false"
				href={otherHref}
				hreflang={otherLocale}
				rel="alternate"
				aria-label={t.nav.switchLanguage}
				title={t.nav.switchLanguage}
			>
				<span lang={otherLocale}>{otherLocale.toUpperCase()}</span>
			</a>
		</div>
	</div>
</header>

<script>
	import { THEME_KEY } from '../i18n/preference';

	const syncToggleLabel = () => {
		const button = document.querySelector<HTMLElement>('[data-theme-toggle]');
		if (!button) return;
		const isLight = document.documentElement.dataset.theme === 'light';
		const label = (isLight ? button.dataset.labelDark : button.dataset.labelLight) ?? '';
		button.setAttribute('aria-label', label);
		button.setAttribute('title', label);
	};

	document.addEventListener('astro:page-load', syncToggleLabel);

	// Delegated: the client router replaces the navbar on every navigation.
	document.addEventListener('click', (event) => {
		const target = event.target as Element;

		if (target.closest('[data-theme-toggle]')) {
			const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
			document.documentElement.dataset.theme = next;
			document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#f4efe4' : '#0b0c0f');
			try {
				localStorage.setItem(THEME_KEY, next);
			} catch {
				// Storage can be blocked: the theme still applies for this page.
			}
			syncToggleLabel();
			return;
		}
	});
</script>

<style>
	.navbar {
		position: sticky;
		top: 0;
		z-index: 100;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: saturate(160%) blur(10px);
		-webkit-backdrop-filter: saturate(160%) blur(10px);
		border-bottom: 1px solid var(--border);
	}

	.navbar-content {
		display: flex;
		align-items: center;
		gap: 2rem;
		height: 64px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.brand:hover {
		color: var(--text);
	}

	.brand-prompt {
		color: var(--accent);
		margin-right: 0.1rem;
	}

	.brand-dot {
		color: var(--text-muted);
	}

	.nav-links {
		display: flex;
		gap: 0.25rem;
		margin-left: auto;
	}

	.nav-links a {
		padding: 0.4rem 0.75rem;
		border-radius: var(--radius-sm);
		color: var(--text-secondary);
		font-size: 0.925rem;
		font-weight: 500;
		transition: color 0.15s ease, background-color 0.15s ease;
	}

	.nav-links a:hover {
		color: var(--text);
		background: var(--bg-subtle);
	}

	.nav-links a[aria-current='page'] {
		color: var(--text);
		background: var(--bg-subtle);
	}

	.nav-tools {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-left: 1rem;
		border-left: 1px solid var(--border);
	}

	.tool {
		display: inline-grid;
		place-items: center;
		min-width: 34px;
		height: 34px;
		padding: 0 0.5rem;
		border-radius: var(--radius-sm);
		border: 1px solid var(--border);
		background: transparent;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
	}

	.tool:hover {
		color: var(--text);
		border-color: var(--border-strong);
		background: var(--bg-subtle);
	}

	.tool svg {
		width: 16px;
		height: 16px;
	}

	/* Shows what the button switches to. */
	.icon-moon {
		display: none;
	}

	:global([data-theme='light']) .icon-sun {
		display: none;
	}

	:global([data-theme='light']) .icon-moon {
		display: block;
	}

	@media (max-width: 768px) {
		.navbar-content {
			display: grid;
			grid-template-columns: 1fr auto;
			grid-template-areas:
				'brand tools'
				'links links';
			height: auto;
			gap: 0;
			padding-top: 0.5rem;
		}

		.brand {
			grid-area: brand;
			min-height: 44px;
		}

		.nav-tools {
			grid-area: tools;
			border-left: none;
			padding-left: 0;
		}

		.tool {
			min-width: 44px;
			height: 44px;
		}

		.nav-links {
			grid-area: links;
			margin: 0 -0.5rem;
			justify-content: space-between;
		}

		.nav-links a {
			padding: 0.7rem 0.5rem;
			background: none !important;
			border-bottom: 2px solid transparent;
			border-radius: 0;
		}

		.nav-links a[aria-current='page'] {
			border-bottom-color: var(--text);
		}
	}
</style>
