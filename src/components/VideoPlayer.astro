		padding: 0.45rem 0.85rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--radius-sm);
		background: var(--vp-panel);
		color: var(--vp-accent);
		font-size: 0.9rem;
		font-weight: 600;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	.vp-osd::before {
		content: '> ';
		color: var(--vp-muted);
	}

	.vp-osd.is-on {
		opacity: 1;
		transition: none;
	}

	.vp-error {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		gap: 0.75rem;
		text-align: center;
		background: rgba(0, 0, 0, 0.8);
		font-size: 0.9rem;
	}

	.vp-error a {
		color: var(--vp-accent);
	}

	/* --- Shortcut help --------------------------------------------------------- */

	.vp-help {
		position: absolute;
		inset: 0 0 64px;
		display: grid;
		place-items: center;
		padding: 1rem;
		background: rgba(0, 0, 0, 0.55);
		overflow: auto;
	}

	.vp-help-box {
		width: min(660px, 100%);
		padding: 0.9rem 1.1rem 1rem;
		background: var(--vp-panel);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--radius);
	}

	.vp-help-title {
